                onTap: () {},
              ),
              SettingsTileWidget(
                icon: Icons.devices,
                title: 'Device Management',
                subtitle: 'Review active devices',
                onTap: () {},
              ),
              SettingsTileWidget(
                icon: Icons.logout,
                title: 'Logout',
                subtitle: 'Securely sign out of your account',
                onTap: () {},
                trailing: const Icon(Icons.arrow_forward_ios, size: 16),
              ),
              const SizedBox(height: 20),
              const SectionHeaderWidget(
                title: 'Payment Methods',
                subtitle: 'Linked bank accounts and cards',
              ),
              const SizedBox(height: 12),
              PaymentMethodsSection(onAddMethod: () {}),
              const SizedBox(height: 20),
              const SectionHeaderWidget(
                title: 'Rewards & Cashback',
                subtitle: 'Track your earnings and referrals',
              ),
              const SizedBox(height: 12),
              const RewardsSection(),
              const SizedBox(height: 20),
              const SectionHeaderWidget(
                title: 'Support',
                subtitle: 'Get help whenever you need it',
              ),
              const SizedBox(height: 12),
              SettingsTileWidget(
                icon: Icons.help_outline,
                title: 'Help Center',
                subtitle: 'Frequently asked questions',
                onTap: () {},
              ),
              SettingsTileWidget(
                icon: Icons.phone_in_talk_outlined,
                title: 'Contact Support',
                subtitle: 'Chat or call support',
                onTap: () {},
              ),
              SettingsTileWidget(
                icon: Icons.report_problem_outlined,
                title: 'Report Issue',
                subtitle: 'Submit a transaction dispute',
                onTap: () {},
              ),
              const SizedBox(height: 20),
              const SectionHeaderWidget(
                title: 'Preferences',
                subtitle: 'Customize your app experience',
              ),
              const SizedBox(height: 12),
              SettingsTileWidget(
                icon: Icons.notifications_active_outlined,
                title: 'Notification Settings',
                trailing: Switch(
                  value: _isNotificationsEnabled,
                  activeThumbColor: AppThemeData.brandPrimaryBlue,
                  onChanged: _toggleNotifications,
                ),
                onTap: () {},
              ),
              SettingsTileWidget(
                icon: Icons.language,
                title: 'Language',
                subtitle: 'English',
